# PostgreSQL connection (native local install, no Docker)
DATABASE_URL=postgresql+asyncpg://postgres:your_password@localhost:5432/transitops

# JWT — generate a long random secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace_with_a_long_random_hex_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS — space-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173

# App
APP_ENV=development
